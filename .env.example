# ── StreamFab Docker — Umgebungsvariablen ─────────────────────────────────────

# VNC-Passwort (Login im Browser, Session-Lock und Schutz der VPN-Buttons)
VNC_PASSWORD=mein-sicheres-passwort

# Session Timeout in Sekunden (0 = keine Sperre)
SESSION_TIMEOUT=0

# User/Gruppe, denen Downloads und Einstellungen gehören
# Auf der NAS per SSH ermitteln:  id <dein-benutzername>
PUID=1026
PGID=100

TZ=Europe/Berlin

# Virtuelle Bildschirmgröße
SCREEN_WIDTH=1600
SCREEN_HEIGHT=900

# Skalierung in Wine: 96 = 100 %, 120 = 125 %, 144 = 150 %
WINE_DPI=96

# VPN beim Containerstart: off | uk | us | au (Ordnername unter config/vpn/)
VPN_START=off
